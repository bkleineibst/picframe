<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/syncProgressBarContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:background="#CC222222"
    android:padding="8dp"
    android:elevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_gravity="top|center_horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ProgressBar
                android:id="@+id/syncProgressSpinner"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="120dp"
                android:layout_height="24dp"
                android:indeterminate="true"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/syncProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/syncing"
                android:textColor="#fff"
                android:textSize="16sp"
                android:maxLines="1"
                android:ellipsize="end" />

			<TextView
				android:id="@+id/syncProgressFile"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text=""
				android:textColor="#bbb"
				android:textSize="13sp"
				android:maxLines="1"
				android:ellipsize="end"
				android:layout_marginTop="2dp" />
		</LinearLayout>

        <ImageButton
			android:id="@+id/btnToggleDebugLog"
			android:layout_width="32dp"
			android:layout_height="32dp"
			android:background="@android:color/transparent"
			android:contentDescription="@string/show_debug_log"
			android:src="@android:drawable/ic_menu_info_details"
			android:layout_marginStart="4dp"
			android:layout_gravity="end" />

	</LinearLayout>
</FrameLayout>
