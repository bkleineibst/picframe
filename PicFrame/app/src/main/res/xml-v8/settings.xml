<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:icon="@android:drawable/ic_menu_preferences"
        android:key="@string/sett_key_cat1"
        android:title="@string/sett_cat1">
        <CheckBoxPreference
            android:title="@string/sett_slideShow"
            android:summary="@string/sett_slideShowSumm"
            android:summaryOff="@string/sett_slideShowSummOff"
            android:summaryOn="@string/sett_slideShowSummOn"
            android:defaultValue="true"
            android:key="@string/sett_key_slideshow" />
        <ListPreference
            android:title="@string/sett_displayTime"
            android:summary="@string/sett_displayTimeSumm"
            android:key="@string/sett_key_displaytime"
            android:dependency="Slideshow"
            android:defaultValue="2"
            android:entries="@array/displayTimeEntries"
            android:entryValues="@array/displayTimeValues" />
        <ListPreference
            android:title="@string/sett_transition"
            android:summary="@string/sett_transitionSumm"
            android:key="@string/sett_key_transition"
            android:dependency="Slideshow"
            android:defaultValue="10"
            android:entries="@array/transitionTypeEntries"
            android:entryValues="@array/transitionTypeValues" />
        <CheckBoxPreference
            android:title="@string/sett_scaling"
            android:summary="@string/sett_scalingSumm"
            android:summaryOff="@string/sett_scalingSummOff"
            android:summaryOn="@string/sett_scalingSummOn"
            android:defaultValue="false"
            android:key="@string/sett_key_scaling" />
        <CheckBoxPreference
            android:title="@string/sett_randomize"
            android:summary="@string/sett_randomizeSumm"
            android:summaryOff="@string/sett_randomizeSummOff"
            android:summaryOn="@string/sett_randomizeSummOn"
            android:key="@string/sett_key_randomize"
            android:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="@string/sett_key_cat_overlay"
        android:title="@string/sett_cat_overlay">
        <ListPreference
            android:title="@string/sett_overlay_size"
            android:summary="@string/sett_overlay_sizeSumm"
            android:key="@string/sett_key_overlay_size"
            android:defaultValue="1"
            android:entries="@array/overlaySizeEntries"
            android:entryValues="@array/overlaySizeValues" />
        <ListPreference
            android:title="@string/sett_overlay_style"
            android:summary="@string/sett_overlay_styleSumm"
            android:key="@string/sett_key_overlay_style"
            android:defaultValue="2"
            android:entries="@array/overlayStyleEntries"
            android:entryValues="@array/overlayStyleValues" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="@string/sett_key_cat_datetime_overlay"
        android:title="@string/sett_cat_datetime_overlay">
        <CheckBoxPreference
            android:title="@string/sett_overlay_enabled"
            android:summary="@string/sett_overlay_enabledSumm"
            android:summaryOff="@string/sett_overlay_enabledSummOff"
            android:summaryOn="@string/sett_overlay_enabledSummOn"
            android:defaultValue="false"
            android:key="@string/sett_key_overlay_enabled" />
        <ListPreference
            android:title="@string/sett_overlay_format"
            android:summary="@string/sett_overlay_formatSumm"
            android:key="@string/sett_key_overlay_format"
            android:dependency="OverlayEnabled"
            android:defaultValue="2"
            android:entries="@array/overlayFormatEntries"
            android:entryValues="@array/overlayFormatValues" />
        <ListPreference
            android:title="@string/sett_overlay_position"
            android:summary="@string/sett_overlay_positionSumm"
            android:key="@string/sett_key_overlay_position"
            android:dependency="OverlayEnabled"
            android:defaultValue="5"
            android:entries="@array/overlayPositionEntries"
            android:entryValues="@array/overlayPositionValues" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="@string/sett_key_cat_location_overlay"
        android:title="@string/sett_cat_location_overlay">
        <CheckBoxPreference
            android:title="@string/sett_location_enabled"
            android:summary="@string/sett_location_enabledSumm"
            android:summaryOff="@string/sett_location_enabledSummOff"
            android:summaryOn="@string/sett_location_enabledSummOn"
            android:defaultValue="false"
            android:key="@string/sett_key_location_enabled" />
        <ListPreference
            android:title="@string/sett_location_format"
            android:summary="@string/sett_location_formatSumm"
            android:key="@string/sett_key_location_format"
            android:dependency="LocationEnabled"
            android:defaultValue="0"
            android:entries="@array/locationFormatEntries"
            android:entryValues="@array/locationFormatValues" />
        <ListPreference
            android:title="@string/sett_location_position"
            android:summary="@string/sett_location_positionSumm"
            android:key="@string/sett_key_location_position"
            android:dependency="LocationEnabled"
            android:defaultValue="3"
            android:entries="@array/overlayPositionEntries"
            android:entryValues="@array/overlayPositionValues" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="@string/sett_key_cat2"
        android:title="@string/sett_cat2" >
        <ListPreference
            android:title="@string/sett_srcType"
            android:summary="@string/sett_srcTypeSumm"
            android:key="@string/sett_key_srctype"
            android:defaultValue="0"
            android:entries="@array/srcTypeEntries"
            android:entryValues="@array/srcTypeValues" />
        <!-- remaining Preferences will be set programmatically in SettingsActivity -->
    </PreferenceCategory>

</PreferenceScreen>